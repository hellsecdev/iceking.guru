---
import { youtubeEmbed } from '../../content/site';

interface Props {
  videoId: string;
  title: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  /** Заполняет родителя (absolute inset-0) */
  fill?: boolean;
}

const { videoId, title, loading = 'lazy', class: className = '', fill = false } = Astro.props;
---

<div
  class:list={[
    'youtube-cover overflow-hidden',
    fill ? 'absolute inset-0' : 'relative h-full min-h-full w-full',
    className,
  ]}
>
  <iframe
    class="youtube-cover__iframe border-0"
    src={youtubeEmbed(videoId)}
    title={title}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    loading={loading}
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>
