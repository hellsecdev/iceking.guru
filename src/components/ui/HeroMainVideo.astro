---
/** Три кадра в колонке HERO (~60% ширины контейнера, как Elementor widget). */
import { asset, site } from '../../content/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const videoSrc = asset(site.heroMainVideo);
---

<div
  class:list={[
    'w-full overflow-hidden rounded-2xl bg-black shadow-lg ring-1 ring-white/80 lg:ms-auto lg:me-0 lg:max-w-[92%]',
    className,
  ]}
>
  <div class="relative aspect-[16/7] w-full sm:aspect-[2.8/1]">
    <video
      class="absolute inset-0 h-full w-full border-0 object-cover"
      src={videoSrc}
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
      title="Ice King — אמבטיות קרח"
    ></video>
  </div>
</div>
