---
/** Три кадра в колонке HERO (~60% ширины контейнера, как Elementor widget). */
import { site, youtubeEmbed } from '../../content/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full overflow-hidden rounded-2xl bg-black shadow-lg ring-1 ring-white/80 lg:mx-0',
    className,
  ]}
>
  <div class="relative aspect-[2.35/1] w-full sm:aspect-[2.2/1]">
    <iframe
      class="absolute inset-0 h-full w-full border-0"
      src={youtubeEmbed(site.heroVideoMain)}
      title="Ice King — אמבטיות קרח"
      allow="autoplay; encrypted-media"
      loading="lazy"
    ></iframe>
  </div>
</div>
