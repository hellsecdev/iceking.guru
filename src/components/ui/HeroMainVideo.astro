---
/** Три кадра в колонке HERO, 16:9 по центру. */
import { asset, site } from '../../content/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const videoSrc = asset(site.heroMainVideo);
---

<div
  class:list={[
    'mx-auto w-full overflow-hidden rounded-2xl bg-black shadow-lg',
    className,
  ]}
>
  <div class="relative aspect-video w-full">
    <video
      class="absolute inset-0 h-full w-full border-0 object-cover"
      src={videoSrc}
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
      title="Ice King — אמבטיות קרח"
    ></video>
  </div>
</div>
