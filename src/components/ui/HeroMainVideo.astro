---
/** Три кадра в колонке HERO (~60% ширины контейнера, как Elementor widget). */
import { site } from '../../content/site';
import YoutubeCover from './YoutubeCover.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full overflow-hidden rounded-2xl bg-black shadow-lg ring-1 ring-white/80 lg:ms-auto lg:me-0 lg:max-w-[92%]',
    className,
  ]}
>
  <div class="relative aspect-[2.8/1] w-full sm:aspect-[16/7]">
    <YoutubeCover
      videoId={site.heroVideoMain}
      title="Ice King — אמבטיות קרח"
      loading="lazy"
      class="absolute inset-0"
    />
  </div>
</div>
