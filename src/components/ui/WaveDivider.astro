---
interface Props {
  flip?: boolean;
  class?: string;
}

const { flip = false, class: className = '' } = Astro.props;
---

<div class:list={['pointer-events-none w-full leading-[0]', className]} aria-hidden="true">
  <svg
    class:list={['block h-12 w-full md:h-16', flip && 'rotate-180']}
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
  >
    <path
      d="M0,64 C300,120 900,0 1200,64 L1200,120 L0,120 Z"
      fill="currentColor"
      class="text-ice-50"></path>
  </svg>
</div>
