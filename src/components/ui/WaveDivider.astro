---
interface Props {
  flip?: boolean;
  class?: string;
  /** Чуть выше волна для стыка видео → hero */
  variant?: 'default' | 'hero';
}

const { flip = false, class: className = '', variant = 'default' } = Astro.props;

const heightClass = variant === 'hero' ? 'h-16 md:h-20 lg:h-24' : 'h-14 md:h-20';

/** Одна кривая: заливка только под волной (без полосы сверху) */
const wavePath =
  variant === 'hero'
    ? 'M0,56 C320,108 640,24 960,64 C1120,84 1280,96 1440,72 L1440,120 L0,120 Z'
    : 'M0,64 C300,120 900,0 1200,64 L1200,120 L0,120 Z';

const viewBox = variant === 'hero' ? '0 0 1440 120' : '0 0 1200 120';
---

<div
  class:list={['pointer-events-none w-full leading-[0]', className]}
  aria-hidden="true"
>
  <svg
    class:list={['block w-full text-ice-50', heightClass, flip && 'rotate-180']}
    viewBox={viewBox}
    preserveAspectRatio="none"
  >
    <path d={wavePath} fill="currentColor"></path>
  </svg>
</div>
