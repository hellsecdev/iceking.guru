---
import { asset, site } from '../../content/site';

const { footerCredit } = site;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__credit" dir="ltr" lang="en">
      <span>{footerCredit.prefix}</span>{' '}
      <span class="site-footer__heart" aria-hidden="true">❤️</span>{' '}
      <span>{footerCredit.middle}</span>{' '}
      <a
        href={footerCredit.url}
        target="_blank"
        rel="noopener noreferrer"
        class="site-footer__brand"
      >
        {footerCredit.brand}
      </a>
    </p>
    <a
      href={footerCredit.url}
      target="_blank"
      rel="noopener noreferrer"
      class="site-footer__logo-link"
      aria-label="HellSec Development & Cybersecurity"
    >
      <img
        src={asset(footerCredit.logo)}
        alt="HellSec"
        class="site-footer__logo"
        width="72"
        height="72"
        loading="lazy"
      />
    </a>
  </div>
</footer>
