---
import { asset, site, whatsappUrl } from '../../content/site';

const { footerCredit } = site;
const waLink = whatsappUrl('שלום, אשמח ליצור קשר');
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__nap" dir="rtl">
      <p class="site-footer__nap-line">
        <strong>{site.name}</strong> – אמבטיות קרח
      </p>
      <p class="site-footer__nap-line">
        {site.location}, ישראל
      </p>
      <p class="site-footer__nap-line">
        טלפון:
        <a href={`tel:${site.phoneTel}`} class="site-footer__nap-link">{site.phone}</a>
        ·
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="site-footer__nap-link">
          WhatsApp
        </a>
      </p>
      <p class="site-footer__nap-line">
        <a href={`mailto:${site.email}`} class="site-footer__nap-link">{site.email}</a>
      </p>
    </div>
    <p class="site-footer__credit" dir="ltr" lang="en">
      <span>{footerCredit.prefix}</span>{' '}
      <span class="site-footer__heart" aria-hidden="true">❤️</span>{' '}
      <span>{footerCredit.middle}</span>{' '}
      <a
        href={footerCredit.url}
        target="_blank"
        rel="noopener noreferrer"
        class="site-footer__brand"
      >
        {footerCredit.brand}
      </a>
    </p>
    <a
      href={footerCredit.url}
      target="_blank"
      rel="noopener noreferrer"
      class="site-footer__logo-link"
      aria-label="HellSec Development & Cybersecurity"
    >
      <img
        src={asset(footerCredit.logo)}
        alt="HellSec"
        class="site-footer__logo"
        width="72"
        height="72"
        loading="lazy"
      />
    </a>
  </div>
</footer>
