---
import { site } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';

const embed = `https://www.youtube-nocookie.com/embed/${site.heroVideoId}?autoplay=1&mute=1&loop=1&playlist=${site.heroVideoId}&controls=0&playsinline=1&rel=0&modestbranding=1&showinfo=0`;
---

<section class="relative min-h-[50vh] overflow-hidden bg-ice-50 md:min-h-[65vh] lg:min-h-[75vh]">
  <div class="absolute inset-0">
    <iframe
      class="pointer-events-none absolute left-1/2 top-1/2 h-[56.25vw] min-h-full min-w-[177.78vh] w-[177.78vh] -translate-x-1/2 -translate-y-1/2"
      src={embed}
      title="ICE KING"
      allow="autoplay; encrypted-media"
      loading="eager"
    ></iframe>
    <div class="absolute inset-0 bg-gradient-to-b from-ice-50/30 via-transparent to-ice-50/80"></div>
  </div>

  <WaveDivider class="absolute bottom-0 left-0 z-10 w-full" />
</section>
