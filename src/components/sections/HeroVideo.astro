---
/** Верх: ледяное видео на всю ширину экрана (WordPress background_video). */
import { asset, site } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';
import YoutubeCover from '../ui/YoutubeCover.astro';

const poster = asset('FROST-KING11.jpg');
---

<section class="relative w-full overflow-hidden bg-ice-50" aria-label="וידאו קרח">
  <div
    class="relative w-full min-h-[min(52vh,720px)] sm:min-h-[48vh] md:min-h-[52vh]"
    style={`background: #0a1628 url('${poster}') center / cover no-repeat;`}
  >
    <YoutubeCover
      videoId={site.heroVideoBg}
      title="ICE KING — קרח"
      loading="eager"
      fill
    />
    <div
      class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-b from-black/10 via-transparent to-[#D8F5FD]/90"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-0 z-[2] flex items-center justify-center px-4"
    >
      <img
        src={asset('ICEKING213213.png')}
        alt={site.name}
        class="h-24 w-auto drop-shadow-lg md:h-32 lg:h-40"
        width="320"
        height="128"
        loading="eager"
      />
    </div>
  </div>

  <WaveDivider class="relative z-10 -mb-px w-full" />
</section>
