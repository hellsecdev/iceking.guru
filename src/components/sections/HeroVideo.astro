---
/** Верх: ледяное видео на всю ширину экрана (WordPress background_video). */
import { site, youtubeEmbed } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';
---

<section
  class="relative left-1/2 w-screen max-w-none -translate-x-1/2 overflow-hidden bg-ice-50"
  aria-label="וידאו קרח"
>
  <div class="relative aspect-[21/9] min-h-[200px] w-full sm:aspect-[2.4/1] md:min-h-[280px] lg:min-h-[340px]">
    <iframe
      class="pointer-events-none absolute inset-0 h-full w-full border-0"
      src={youtubeEmbed(site.heroVideoBg)}
      title="ICE KING — קרח"
      allow="autoplay; encrypted-media"
      loading="eager"
    ></iframe>
    <div class="absolute inset-0 bg-gradient-to-b from-ice-50/10 via-transparent to-ice-50/75"></div>
  </div>

  <WaveDivider class="relative z-10 -mb-px w-full" />
</section>
