---
/** Верх страницы: ледяное background-video (как в WordPress). */
import { site, youtubeEmbed } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';
---

<section
  class="relative min-h-[38vh] overflow-hidden bg-ice-50 md:min-h-[50vh] lg:min-h-[58vh]"
  aria-label="וידאו קרח"
>
  <div class="absolute inset-0">
    <iframe
      class="pointer-events-none absolute left-1/2 top-1/2 h-[56.25vw] min-h-full min-w-[177.78vh] w-[177.78vh] -translate-x-1/2 -translate-y-1/2 border-0"
      src={youtubeEmbed(site.heroVideoBg)}
      title="ICE KING — קרח"
      allow="autoplay; encrypted-media"
      loading="eager"
    ></iframe>
    <div
      class="absolute inset-0 bg-gradient-to-b from-ice-50/20 via-transparent to-ice-50/85"
    ></div>
  </div>

  <WaveDivider class="absolute bottom-0 left-0 z-10 w-full" />
</section>
