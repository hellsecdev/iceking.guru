---
/** Верх: ледяное видео на всю ширину экрана (WordPress background_video). */
import { asset, site } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';
import YoutubeCover from '../ui/YoutubeCover.astro';
---

<section
  class="relative left-1/2 w-screen max-w-none -translate-x-1/2 overflow-hidden bg-ice-50"
  aria-label="וידאו קרח"
>
  <div
    class="relative min-h-[38vh] w-full sm:min-h-[42vh] md:min-h-[48vh] lg:min-h-[52vh]"
  >
    <YoutubeCover
      videoId={site.heroVideoBg}
      title="ICE KING — קרח"
      loading="eager"
      class="absolute inset-0"
    />
    <div
      class="absolute inset-0 z-[1] bg-gradient-to-b from-black/5 via-transparent to-[#D8F5FD]"
      aria-hidden="true"
    ></div>
    <div class="pointer-events-none absolute inset-0 z-[2] flex items-center justify-center px-4">
      <img
        src={asset('ICEKING213213.png')}
        alt={site.name}
        class="h-24 w-auto drop-shadow-lg md:h-32 lg:h-40"
        width="320"
        height="128"
        loading="eager"
      />
    </div>
  </div>

  <WaveDivider class="relative z-10 -mb-px w-full" />
</section>
