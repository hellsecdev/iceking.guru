---
/**
 * Верхний блок: только основное YouTube-видео (над меню), как на WordPress.
 */
import { site } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';

const id = site.heroVideoTop;
const embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&playsinline=1&rel=0&modestbranding=1`;
---

<section
  class="relative overflow-hidden bg-black"
  aria-label="סרטון Ice King"
>
  <div class="relative aspect-video w-full max-h-[85vh] min-h-[220px] md:min-h-[380px] lg:min-h-[480px]">
    <iframe
      class="absolute inset-0 h-full w-full"
      src={embed}
      title="ICE KING — וידאו"
      allow="autoplay; encrypted-media; picture-in-picture"
      allowfullscreen
      loading="eager"
    ></iframe>
  </div>

  <WaveDivider class="relative z-10 -mb-px" />
</section>
