---
import { site } from '../../content/site';
import WaveDivider from '../ui/WaveDivider.astro';

const bgEmbed = `https://www.youtube-nocookie.com/embed/${site.heroVideoBg}?autoplay=1&mute=1&loop=1&playlist=${site.heroVideoBg}&controls=0&playsinline=1&rel=0&modestbranding=1`;
const mainEmbed = `https://www.youtube-nocookie.com/embed/${site.heroVideoMain}?autoplay=1&mute=1&loop=1&playlist=${site.heroVideoMain}&controls=0&playsinline=1&rel=0&modestbranding=1`;
---

<section class="relative min-h-[280px] overflow-hidden md:min-h-[420px] lg:min-h-[520px]">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <iframe
      class="pointer-events-none absolute left-1/2 top-1/2 h-[56.25vw] min-h-full min-w-[177.78vh] w-[177.78vh] -translate-x-1/2 -translate-y-1/2"
      src={bgEmbed}
      title="ICE KING background"
      allow="autoplay; encrypted-media"
      loading="eager"
    ></iframe>
    <div class="absolute inset-0 bg-sky-100/40"></div>
  </div>

  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 pb-8 pt-6 md:pb-12 md:pt-10">
    <div class="aspect-video w-full max-w-3xl overflow-hidden rounded-xl shadow-2xl">
      <iframe
        class="h-full w-full"
        src={mainEmbed}
        title="ICE KING"
        allow="autoplay; encrypted-media"
        loading="eager"
      ></iframe>
    </div>
  </div>

  <WaveDivider />
</section>
