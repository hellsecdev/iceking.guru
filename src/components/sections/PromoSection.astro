---
import { asset } from '../../content/site';
import { promo } from '../../content/sections';
import WaveDivider from '../ui/WaveDivider.astro';
---

<section id="promo" class="section-icy section-icy--seam relative -mt-px pb-0 pt-10 md:pt-12">
  <div class="site-wrap flex justify-center">
    <img
      src={asset(promo.image)}
      alt={promo.imageAlt}
      class="h-auto w-full max-w-3xl object-contain lg:max-w-4xl"
      loading="lazy"
      width="1200"
      height="675"
    />
  </div>
  <WaveDivider variant="soft" class="relative z-10 -mb-px mt-8 md:mt-10" />
</section>
