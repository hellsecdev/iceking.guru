---
import { asset, site, whatsappUrl } from '../../content/site';
import SocialLinks from '../ui/SocialLinks.astro';

const waLink = whatsappUrl('שלום, אשמח ליצור קשר');
---

<header class="relative z-20 py-3 md:py-5">
  <div
    class="site-wrap grid grid-cols-1 items-center gap-4 md:grid-cols-[1fr_auto_1fr] md:gap-6"
    dir="ltr"
  >
    <!-- Слева: телефон + соцсети -->
    <div class="flex flex-wrap items-center justify-center gap-3 md:justify-start md:gap-4">
      <a href={`tel:${site.phoneTel}`} class="btn-header-cta shrink-0">
        <img src={asset('ICEKING-5.png')} alt="" class="h-6 w-6 shrink-0 md:h-7 md:w-7" />
        {site.phone}
      </a>
      <SocialLinks />
    </div>

    <!-- Строго по центру экрана -->
    <div class="flex justify-center md:row-start-1">
      <a href={import.meta.env.BASE_URL} class="block">
        <img
          src={asset('ICEKING213213.png')}
          alt={site.name}
          class="h-28 w-auto md:h-36 lg:h-[9.5rem]"
          width="400"
          height="160"
        />
      </a>
    </div>

    <!-- Справа: адрес + WhatsApp -->
    <div class="flex flex-wrap items-center justify-center gap-3 md:justify-end md:gap-4">
      <p
        class="flex shrink-0 items-center gap-1.5 text-base font-semibold text-ice-400 md:text-lg"
      >
        <span class="text-lg text-red-500 md:text-xl" aria-hidden="true">📍</span>
        {site.location}
      </p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-header-cta shrink-0"
      >
        <img src={asset('ICEKING45465.png')} alt="" class="h-6 w-6 shrink-0 md:h-7 md:w-7" />
        צור קשר WhatsApp
      </a>
    </div>
  </div>
</header>
