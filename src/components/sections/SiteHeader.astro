---
import { asset, site, whatsappUrl } from '../../content/site';
import SocialLinks from '../ui/SocialLinks.astro';

const waLink = whatsappUrl('שלום, אשמח ליצור קשר');
---

<header class="relative z-20 py-3 md:py-4">
  <!-- Desktop: телефон | соцсети по центру зоны | лого | адрес по центру зоны | WhatsApp -->
  <div class="site-wrap hidden items-center md:flex" dir="ltr">
    <div class="flex min-w-0 flex-1 items-center">
      <a href={`tel:${site.phoneTel}`} class="btn-header-cta shrink-0">
        {site.phone}
      </a>
      <div class="flex min-w-0 flex-1 justify-center px-3 lg:px-6">
        <SocialLinks />
      </div>
    </div>

    <a
      href={import.meta.env.BASE_URL}
      class="mx-3 block shrink-0 lg:mx-5"
      aria-label={site.name}
    >
      <img
        src={asset('ICEKING213213.png')}
        alt={site.name}
        class="h-24 w-auto md:h-32 lg:h-36"
        width="400"
        height="160"
      />
    </a>

    <div class="flex min-w-0 flex-1 items-center">
      <div class="flex min-w-0 flex-1 justify-center px-3 lg:px-6">
        <p
          class="flex shrink-0 items-center gap-1.5 whitespace-nowrap text-lg font-semibold text-ice-400 md:text-xl"
        >
          <span class="text-xl text-red-500 md:text-2xl" aria-hidden="true">📍</span>
          {site.location}
        </p>
      </div>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-header-cta shrink-0 whitespace-nowrap"
      >
        צור קשר WhatsApp
      </a>
    </div>
  </div>

  <!-- Mobile -->
  <div class="site-wrap flex flex-col items-center gap-4 md:hidden" dir="ltr">
    <a href={import.meta.env.BASE_URL} class="block">
      <img
        src={asset('ICEKING213213.png')}
        alt={site.name}
        class="h-24 w-auto"
        width="320"
        height="128"
      />
    </a>
    <div class="flex w-full max-w-lg flex-wrap items-center justify-center gap-3">
      <a href={`tel:${site.phoneTel}`} class="btn-header-cta shrink-0">
        {site.phone}
      </a>
      <SocialLinks />
      <p class="flex shrink-0 items-center gap-1.5 text-lg font-semibold text-ice-400">
        <span class="text-xl text-red-500" aria-hidden="true">📍</span>
        {site.location}
      </p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-header-cta shrink-0"
      >
        צור קשר WhatsApp
      </a>
    </div>
  </div>
</header>
