---
import { asset, site, whatsappUrl } from '../../content/site';
import SocialLinks from '../ui/SocialLinks.astro';

const waLink = whatsappUrl('שלום, אשמח ליצור קשר');
---

<header
  class="section-icy relative z-20 -mt-16 border-b border-white/60 px-4 pb-5 pt-20 shadow-sm md:-mt-20 md:px-6 md:pt-24"
>
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 md:flex-row md:justify-between md:gap-6">
    <div class="flex w-full flex-wrap items-center justify-center gap-2 md:w-auto md:justify-start">
      <a href={`tel:${site.phoneTel}`} class="btn-pill text-xs md:text-sm">
        <img src={asset('ICEKING-5.png')} alt="" class="h-5 w-5" />
        {site.phone}
      </a>
      <SocialLinks />
    </div>

    <a href={import.meta.env.BASE_URL} class="shrink-0">
      <img
        src={asset('ICEKING213213.png')}
        alt={site.name}
        class="h-14 w-auto md:h-20"
        width="200"
        height="80"
      />
    </a>

    <div class="flex w-full flex-wrap items-center justify-center gap-2 md:w-auto md:justify-end">
      <p class="flex items-center gap-1 text-sm font-semibold text-ice-400">
        <span aria-hidden="true">📍</span>
        {site.location}
      </p>
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-pill text-xs md:text-sm">
        <img src={asset('ICEKING45465.png')} alt="" class="h-5 w-5" />
        WhatsApp · צור קשר
      </a>
    </div>
  </div>
</header>
