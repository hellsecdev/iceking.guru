---
import ImageCarousel from '../react/ImageCarousel';
import { testimonials } from '../../content/sections';
import { testimonialImages } from '../../content/media';
---

<section id="testimonials" class="section-icy py-14">
  <h2 class="section-title site-wrap mb-10">{testimonials.title}</h2>
  <ImageCarousel
    client:visible
    images={testimonialImages}
    assetBase={import.meta.env.BASE_URL + 'assets'}
    showFraction
  />
</section>
