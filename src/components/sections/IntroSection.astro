---
import { asset } from '../../content/site';
import { intro } from '../../content/sections';
---

<section
  id="intro"
  class="section-icy px-4 py-12 md:py-16"
  style={`background-image: url('${asset('FROST-KING324234234324.jpg')}'); background-size: cover; background-position: bottom center;`}
>
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <div class="space-y-6 text-center lg:text-end">
        <h1 class="text-2xl font-semibold leading-snug text-ice-400 md:text-3xl lg:text-4xl">
          {intro.headline}
        </h1>
        <p class="text-xl font-medium text-ice-300">{intro.welcome}</p>
        <img
          src={asset(intro.heroImage)}
          alt="טבילת קרח ב-Ice King"
          class="mx-auto h-64 w-64 rounded-full object-cover shadow-xl ring-4 ring-white lg:ms-auto lg:me-0"
          loading="lazy"
        />
      </div>

      <div class="space-y-5">
        <h2 class="text-2xl font-semibold text-ice-400 md:text-3xl">{intro.benefitsTitle}</h2>
        <p class="text-lg text-ice-300">{intro.benefitsIntro}</p>
        <ul class="grid gap-2 sm:grid-cols-2">
          {
            intro.benefits.map((item) => (
              <li class="flex items-start gap-2 text-ice-400">
                <span class="mt-1 text-ice-cta" aria-hidden="true">❄️</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <img
          src={asset(intro.stripImage)}
          alt=""
          class="w-full rounded-xl object-cover shadow-md"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
