---
import { faqItems } from '../../content/faq';
import { faqSection } from '../../content/sections';
---

<section id="faq" class="section-icy section-icy--seam relative -mt-px py-14">
  <h2 class="section-title site-wrap mb-10">{faqSection.title}</h2>
  <div class="site-wrap space-y-2">
    {
      faqItems.map((item) => (
        <details class="group rounded-lg border border-ice-50/80 bg-white/60 px-4 py-3 shadow-sm open:bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-lg font-semibold text-ice-300 marker:content-none">
            <span class="flex items-center gap-2 text-end">
              <span aria-hidden="true">{item.emoji}</span>
              {item.question}
            </span>
            <span class="shrink-0 text-2xl text-ice-cta transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 border-t border-ice-50 pt-3 text-ice-400">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
