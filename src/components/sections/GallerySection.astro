---
import ImageCarousel from '../react/ImageCarousel';
import { gallerySection } from '../../content/sections';
import { galleryImages } from '../../content/media';
import WaveDivider from '../ui/WaveDivider.astro';
---

<section
  id="gallery"
  class="section-icy px-4 py-14"
  style="background-image: url('/assets/FROST-KING6666.jpg'); background-size: cover; background-position: top center;"
>
  <h2 class="section-title mb-10">{gallerySection.title}</h2>
  <ImageCarousel client:visible images={galleryImages} slidesToShow={3} />
</section>
<WaveDivider />
