---
import { asset } from '../../content/site';
import { services, servicesTitle } from '../../content/services';
import WaveDivider from '../ui/WaveDivider.astro';
---

<section id="services" class="section-icy section-icy--seam relative -mt-px pb-0 pt-12 md:pt-14">
  <h2 class="section-title site-wrap mb-10 md:mb-12">{servicesTitle}</h2>
  <div class="site-wrap grid gap-8 sm:grid-cols-2 xl:grid-cols-4">
    {
      services.map((service) => (
        <article class="flex flex-col items-center">
          <img
            src={asset(service.image)}
            alt={service.title}
            class="h-auto w-full max-w-full object-contain"
            loading="lazy"
            decoding="async"
          />
          <p class="mt-4 w-full flex-1 text-sm leading-relaxed text-ice-300 md:text-base">
            {service.description}
          </p>
        </article>
      ))
    }
  </div>
  <WaveDivider variant="soft" class="relative z-10 -mb-px mt-10 md:mt-12" />
</section>
