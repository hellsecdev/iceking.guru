---
/**
 * HERO: меню + две колонки. Ролик с 3 кадрами — в левой колонке (как WordPress).
 */
import { asset } from '../../content/site';
import { intro } from '../../content/sections';
import HeroMainVideo from '../ui/HeroMainVideo.astro';
import SiteHeader from './SiteHeader.astro';
import WaveDivider from '../ui/WaveDivider.astro';

const benefitsColA = intro.benefits.slice(0, 3);
const benefitsColB = intro.benefits.slice(3);
const frostBg = asset('FROST-KING324234234324.jpg');
---

<section
  id="hero"
  class="section-icy relative overflow-hidden bg-ice-50"
  style={`background-image: linear-gradient(180deg, #D8F5FD 0%, rgba(216,245,253,0.95) 12%, rgba(255,255,255,0.95) 55%), url('${frostBg}'); background-size: cover; background-position: center bottom;`}
>
  <SiteHeader />

  <div class="site-wrap pb-12 pt-0 md:pb-16 md:pt-1">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- RTL: справа — заголовок и круглое фото -->
      <div class="flex flex-col items-center gap-6 text-center">
        <div class="mx-auto max-w-xl space-y-3">
          <h1
            class="text-2xl font-semibold leading-snug text-ice-400 md:text-[1.75rem] lg:text-4xl"
          >
            {intro.headline}
          </h1>
          <p class="text-xl font-semibold text-ice-300 md:text-2xl">
            {intro.welcome}
          </p>
        </div>
        <img
          src={asset(intro.heroImage)}
          alt="טבילת קרח ב-Ice King"
          class="h-[28rem] w-[28rem] max-w-[min(100%,28rem)] shrink-0 rounded-full object-cover md:h-[32rem] md:w-[32rem] md:max-w-[min(100%,32rem)] lg:h-[35rem] lg:w-[35rem] lg:max-w-[min(100%,35rem)]"
          loading="eager"
          width="560"
          height="560"
        />
      </div>

      <!-- RTL: слева — преимущества + видео -->
      <div class="flex flex-col items-center gap-5 text-center">
        <div class="mx-auto max-w-xl space-y-3">
          <h2 class="text-2xl font-semibold text-ice-400 md:text-3xl">
            {intro.benefitsTitle}
          </h2>
          <p class="text-base leading-relaxed text-ice-300 md:text-lg">
            {intro.benefitsIntro}
          </p>
        </div>

        <ul class="mx-auto grid w-full max-w-md gap-3 text-ice-400 sm:grid-cols-2 sm:gap-x-8">
          <li class="space-y-2">
            {
              benefitsColA.map((item) => (
                <p class="flex items-start justify-center gap-2">
                  <span class="mt-0.5 shrink-0 text-ice-cta" aria-hidden="true">❄️</span>
                  <span>{item}</span>
                </p>
              ))
            }
          </li>
          <li class="space-y-2">
            {
              benefitsColB.map((item) => (
                <p class="flex items-start justify-center gap-2">
                  <span class="mt-0.5 shrink-0 text-ice-cta" aria-hidden="true">❄️</span>
                  <span>{item}</span>
                </p>
              ))
            }
          </li>
        </ul>

        <HeroMainVideo class="w-full max-w-2xl" />
      </div>
    </div>
  </div>

  <WaveDivider />
</section>
