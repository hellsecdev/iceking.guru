---
import Layout from '../layouts/Layout.astro';
import HeroVideo from '../components/sections/HeroVideo.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import IntroSection from '../components/sections/IntroSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import PromoSection from '../components/sections/PromoSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import WaveDivider from '../components/ui/WaveDivider.astro';
---

<Layout>
  <main>
    <HeroVideo />
    <SiteHeader />
    <IntroSection />
    <WaveDivider />
    <TestimonialsSection />
    <AboutSection />
    <ServicesSection />
    <PromoSection />
    <FaqSection />
    <GallerySection />
    <ContactSection />
    <SiteFooter />
  </main>
</Layout>
